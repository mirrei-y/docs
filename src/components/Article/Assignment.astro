: <Info>
    この講義は自動提出に対応していません。
</Info>}

<style is:global>
@keyframes tada {
    0% { transform: rotate(0deg); }
    5% { transform: rotate(3deg); }
    10% { transform: rotate(-3deg); }
    15% { transform: rotate(3deg); }
    20% { transform: rotate(-3deg); }
    25% { transform: rotate(0deg); }
}
form#assignment {
    flex: 1;
    text-align: center;
    border: 5px dotted #80808099;
    border-radius: 20px;
    transition: border-color 0.2s;

    &.dragging {
        border-color: #6562bd;
    }

    &:disabled {
        cursor: not-allowed;
        color: currentColor;

        &:focus {
            outline: none;
        }
    }

    [data-type] {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3em;
        font-size: 1em;
        padding: 3rem;

        header {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;

            svg {
                width: 4rem;
                height: 4rem;
            }
        }
        & > p {
            opacity: 0.5;
        }
        button:not(.assignment-upload) {
            border: 1px solid #6562bd;
        }
    }
    button.assignment-upload {
        background: none;
        border: none;
        cursor: pointer;
        width: 100%;

        * {
            pointer-events: none;
        }
    }

    h1, h2, h3, h4, h5, h6, ul, li, p {
        margin: 0px;
    }
    pre {
        margin: 0px;
        text-align: left;

        white-space: break-spaces;
    }
    input[type=file] {
        display: none;
    }

    .controls {
        display: flex;
        flex-direction: column;
        gap: 3rem;

        width: min(100%, 40rem);
        margin-inline: auto;
    }
    .feedback, .code, .opinion {
        margin-top: 1.3rem;

        position: relative;
        &::before {
            display: block;
            position: absolute;
            top: 0px;
            left: 0px;
            transform: translateY(-100%);
            opacity: 0.5;
            font-size: 0.75rem;
            padding-bottom: 0.5rem;
        }
        &.feedback::before {
            content: "フィードバック";
        }
        &.code::before {
            content: "入力されたコード";
        }
        &.opinion::before {
            content: "ご意見・ご感想（任意）";
        }
    }
    .opinion {
        display: flex;
        flex-direction: column;

        textarea {
            padding: 0.5rem;
            resize: vertical;
        }
    }

    [data-type=ready] {
        gap: 1em;

        header {
            opacity: 0.5;
        }
    }
    [data-type=complete] {
        svg {
            margin-bottom: 0.5rem;

            animation: tada 2s ease-in-out infinite;
            transform-origin: center;
        }
    }

    &[data-type=ready] > :not([data-type=ready]) {
        display: none;
    }
    &[data-type=processing] > :not([data-type=processing]) {
        display: none;
    }
    &[data-type=complete] > :not([data-type=complete]) {
        display: none;
    }
    &[data-type=failed] > :not([data-type=failed]) {
        display: none;
    }
}
</style>

{isAvailable ? <script>
    // NOTE: フォームを用意し、各種イベントを設定する
    const formElement = document.querySelector<HTMLFormElement>("#assignment")!;
    const fileElement = formElement.querySelector<HTMLInputElement>("input[type=file]")!;
    const uploadButtonElements = [...formElement.querySelectorAll<HTMLButtonElement>("button.assignment-upload")];
    const injecter = formElement.querySelector<HTMLInputElement>("input[name=injecter]")!.value;
    const asserter = formElement.querySelector<HTMLInputElement>("input[name=asserter]")!.value;
    for (const uploadButton of uploadButtonElements) {
        uploadButton.onclick = evt => {
            if (evt.eventPhase !== evt.BUBBLING_PHASE) fileElement?.click();
        };
        uploadButton.ondragover = evt => {
            evt.preventDefault();
            formElement.classList.add("dragging");
        };
        uploadButton.ondragleave = evt => {
            evt.preventDefault();
            formElement.classList.remove("dragging");
        };
        uploadButton.ondrop = evt => {
            evt.preventDefault();
            formElement.classList.remove("dragging");
            const file = evt.dataTransfer?.files?.[0];
            if (file) checkFile(file);
        };
    }
    fileElement.onchange = () => {
        const file = fileElement.files?.[0];
        if (file) checkFile(file);
    };

    // NOTE: 投げられたファイルをチェックする
    async function checkFile(file: File) {
        uploadButtonElements.forEach(b => { b.disabled = true; });

        // NOTE: ファイルを取得
        if (file.size > 1024 * 1024) return;
        const fileUrl = URL.createObjectURL(file);
        const fileContent = await (await fetch(fileUrl)).text();
        URL.revokeObjectURL(fileUrl);
        fileElement.value = "";

        // NOTE: コードを検査
        const { ok, message, code } = await evaluateCode(fileContent) as { ok: boolean; message: string; code: string; };
        formElement.querySelectorAll(".feedback").forEach(e => {
            (e as HTMLElement).style.display = message ? "" : "none";
            e.textContent = message ?? "";
        });
        formElement.querySelectorAll(".code").forEach(e => e.textContent = code);
        if (ok) {
            formElement.dataset.type = "complete";
        } else {
            formElement.dataset.type = "failed";
            uploadButtonElements.forEach(b => { b.disabled = false; });

            fetch("/api/meister/js/wrong-code", {
                method: "POST",
                body: JSON.stringify({ message, code })
            }).catch(() => { });
        }
    }

    // NOTE: ユーザーのコードをテストする関数群
    const workerUrl = URL.createObjectURL(new Blob([`
        self.onmessage = function(event) {
            if (event.data.type === "execute") {
                try {
                    const result = new Function("__USER_CODE", \`
                        \${event.data.injecter}

                        \${event.data.code}

                        try {
                            return (\${event.data.asserter})();
                        } catch (e) {
                            return {
                                ok: false,
                                message: "システムエラーが発生し、正しく採点できませんでした: " + e.toString()
                            };
                        }
                    \`)(event.data.code);
                    self.postMessage({
                        ok: result.ok,
                        message: result.message,
                    });
                } catch (error) {
                    self.postMessage({
                        ok: false,
                        message: \`エラーが発生しました: \${error.message}\`,
                    });
                }
            }
        };
    `], { type: "text/javascript" }));
    async function evaluateCode(code: string) {
        const worker = new Worker(workerUrl);

        return await new Promise(resolve => {
            const timeout = setTimeout(() => {
                worker.terminate();
                resolve({
                    ok: false,
                    message: "無限ループに陥っています",
                    code,
                });
            }, 3000);

            worker.onmessage = event => {
                clearTimeout(timeout);
                resolve({
                    ...event.data,
                    code,
                });
            };
            worker.onerror = event => {
                resolve({
                    ok: false,
                    message: "システムエラーが発生しました: " + event.message,
                    code,
                });
            };

            console.log(injecter + "\n---\n" + code + "\n---\n" + asserter);
            worker.postMessage({ type: "execute", injecter, asserter, code });
        }).finally(() => {
            worker.terminate();
        });
    }
</script> : null}
