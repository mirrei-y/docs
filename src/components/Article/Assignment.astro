---
import Info from "./Info.astro";
import AssignmentOpinion from "./Assignment/Opinion.astro";

interface Props {
    /**
     * ユーザーから入力されたコードの前に挿入されるコード。
     */
    injecter?: () => any;

    /**
     * ユーザーから入力されたコードを評価する関数の内容。
     *
     * 関数内では、`__USER_CODE` 変数を用いてユーザーの入力した生の文字列を確認することができます。
     *
     * @example ```js
     * const a = userDefinedVariable * 100;
     * if (a >= 4) return { ok: false, message: "4以上であってはなりません" };
     * if (a <= 1) return { ok: false, message: "1以下であってはなりません" };
     * if (a === 2) return { ok: true, message: "まぁ許したるわ" };
     * return { ok: true };
     * ```
     * @example ```js
     * const lines = __USER_CODE.split("\n");
     * const message = `${lines[Math.floor(Math.random() * lines.length)]} が気に食わないからやり直し`;
     * return { ok: false, message };
     * ```
     */
    asserter: () => { ok: boolean; message?: string; };

    /**
     * 受け入れるファイルの MIME タイプ。
     *
     * input[type=file] の accept 属性に準じます。
     */
    accept?: string;
}

function minify(code: string): string {
    // NOTE: 複数行コメント /* ... */ を削除
    code = code.replace(/\/\*[\s\S]*?\*\//g, '');
    // NOTE: 1行コメント // を削除
    code = code.replace(/\/\/.*$/gm, '');
    // NOTE: 余分な空白、タブ、改行を削除
    code = code.replace(/\s+/g, ' ');
    // NOTE: セミコロンの直後のスペースを削除
    code = code.replace(/;\s/g, ';');
    // NOTE: 波括弧の直後のスペースを削除（例: `if (a) { return b; }` -> `if (a){return b;}`）
    code = code.replace(/{\s/g, '{');
    code = code.replace(/\s}/g, '}');
    // NOTE: 丸括弧の直後のスペースを削除
    code = code.replace(/\(\s/g, '(');
    code = code.replace(/\s\)/g, ')');
    // NOTE: `return {` のスペースを削除
    code = code.replace(/(if|return) *([\{\(])/gm, '$1$2');
    // NOTE: 余分なスペースをトリム（先頭と末尾）
    code = code.trim();
    return code;
}

const injecter = Astro.props.injecter ? minify(Astro.props.injecter.toString().replace(/^(function)?\( *\)( *=> *)?{?/, "").replace(/}?$/, "")) : undefined;
const asserter = Astro.props.asserter ? minify(Astro.props.asserter.toString()) : undefined;
const accept = Astro.props.accept;

const isAvailable = typeof Astro.props.asserter === "function";
---

{isAvailable ?
<p>拡張子が <code>.js</code> のファイルに JavaScript プログラムを記述し、ファイルをこのフォームにアップロードしてください。
課題は、次回の講義までにチェック結果の確認を受けることで、提出したものとみなされます。</p>
: <></>}

<h3>要件</h3>
<slot />

<h3>チェックフォーム</h3>
{isAvailable ?
<form id="assignment" data-type="ready">
    <input type="file" accept={accept ?? "text/javascript"}>
    <input type="hidden" name="injecter" value={injecter ?? ""}>
    <input type="hidden" name="asserter" value={asserter ?? ""}>
